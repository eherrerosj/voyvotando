{
  "name": "voyvotando",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Test de afinidad electoral neutral para las elecciones generales del 29/11/2026",
  "license": "AGPL-3.0-only",
  "homepage": "https://voyvotando.bull-labs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/eherrerosj/voyvotando.git"
  },
  "bugs": {
    "url": "https://github.com/eherrerosj/voyvotando/issues"
  },
  "scripts": {
    "data": "python3 -I scripts/export.py",
    "predev": "node scripts/copy-public-data.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-public-data.mjs",
    "build": "astro build",
    "postbuild": "node scripts/csp.mjs",
    "build:all": "npm run data && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validar": "esbuild scripts/validar.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/validar.mjs && node node_modules/.cache/validar.mjs",
    "shots": "node scripts/shots.mjs",
    "deploy": "npm run test && npm run build && wrangler deploy",
    "qa:responsive": "node scripts/responsive-qa.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.155.0",
    "zod": "4.6.7"
  }
}
