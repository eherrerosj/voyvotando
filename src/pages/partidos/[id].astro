---
import Base from "../../layouts/Base.astro";
import { AMBITOS, PARTIES, QUESTIONS } from "../../lib/data";
import { DISPLAY, PARTY_POSITION_LABEL, districtNote, pct } from "../../lib/format";
import { partyCloseness } from "../../lib/scoring";
import { PARTY_IDS, type Party } from "../../lib/types";

export function getStaticPaths() {
  return PARTIES.map((p) => ({ params: { id: p.id }, props: { party: p } }));
}
const { party } = Astro.props as { party: Party };
type Unit = { ambito: number; id: string; title: string; text: string; condition: string | null; A: string | null; B: string | null; C: string | null; E: string | null; figures: string[]; page: number };
const files = import.meta.glob<{ default: Unit[] }>("../../content/units/*.json", { eager: true });
const units = files[`../../content/units/${party.id}.json`].default;
const byAmbito = Object.entries(AMBITOS).map(([n, name]) => ({ n: Number(n), name, units: units.filter((u) => u.ambito === Number(n)) })).filter((g) => g.units.length);
const closeness = PARTY_IDS.filter((p) => p !== party.id)
  .map((p) => ({ p, c: partyCloseness(QUESTIONS, party.id, p) }))
  .filter((x) => x.c)
  .sort((a, b) => b.c!.value - a.c!.value);
const priorities = Object.entries(party.salienceByAmbito).filter(([, s]) => s === "alta").map(([n]) => AMBITOS[n]);
const positions = QUESTIONS.filter((q) => q.positions[party.id].value != null);
const fmt = (iso: string) => (iso ? new Date(iso + "T12:00:00").toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" }) : "");
---
<Base title={`${DISPLAY[party.id]}: programa y posiciones · Voy Votando`} description={`Qué propone ${party.name} para el 29N según el informe de evaluación de su programa: ${party.report.units} propuestas con su viabilidad.`}>
  <section class="section party-hero">
    <div class="wrap">
      <p class="kicker">Ficha de partido</p>
      <h1 class="display party-hero__title">{party.name}</h1>
      <p class="lead">Programa: {party.report.programTitle || "programa electoral"}, presentado el {fmt(party.report.programDate)}. Informe de evaluación de {party.report.pages} páginas con {party.report.units} propuestas analizadas. Corte de información: {fmt(party.report.cutoff)}.</p>
      {districtNote(party.id) && <p class="lead"><strong>{districtNote(party.id)}.</strong> Sus diputados se eligen en esas circunscripciones, y su papel en el Congreso depende de los acuerdos con otros grupos.</p>}
      <a class="btn" href={party.report.pdf} target="_blank" rel="noopener">Leer el informe completo (PDF) <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section--orange">
    <div class="wrap">
      <p class="kicker">Conclusiones del informe</p>
      <ul class="concl">
        {party.conclusions.map((c) => <li><h2 class="serif">{c.title}</h2><p>{c.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid2">
      <div>
        <p class="kicker">Escenarios de gobierno que usa el informe</p>
        <dl class="scen-list">
          {(["A", "B", "C"] as const).map((k) => <div><dt class="display">{k} · {party.scenarios[k].label}</dt><dd>{party.scenarios[k].definition}</dd></div>)}
          <div><dt class="display">E · Entrega</dt><dd>{party.scenarios.E.definition}</dd></div>
        </dl>
      </div>
      <div>
        <p class="kicker">Temas prioritarios según el informe</p>
        <ul class="plain-list">{priorities.map((p) => <li>{p}</li>)}</ul>
        <p class="kicker" style="margin-top:32px">Cercanía con otros partidos en el test</p>
        <ul class="close">
          {closeness.map(({ p, c }) => (
            <li><a href={`/partidos/${p}`}>{DISPLAY[p]}</a><span class="close__bar"><span style={`width:${c!.value}%`}></span></span><strong>{pct(c!.value)}</strong></li>
          ))}
        </ul>
        <p class="small muted">Calculada con las preguntas del test en las que ambos tienen posición documentada.</p>
      </div>
    </div>
  </section>

  <section class="section section--teal">
    <div class="wrap">
      <p class="kicker">Posición en las preguntas del test</p>
      <h2 class="display h2s">{positions.length} de {QUESTIONS.length} con posición documentada</h2>
      <ol class="pos-list">
        {positions.map((q) => (
          <li>
            <span class="pos-list__q">«{q.text}»</span>
            <span class="pos-list__v"><strong>{PARTY_POSITION_LABEL[String(q.positions[party.id].value)]}</strong> <span class="small">(confianza {q.positions[party.id].confidence})</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">Las {units.length} propuestas del informe</p>
      <h2 class="display h2s">Propuestas por ámbito</h2>
      <p class="small">A, B y C: probabilidad cualitativa de aprobación en cada escenario. E: entrega una vez aprobada y financiada. Son juicios del informe, no probabilidades.</p>
      {byAmbito.map((g) => (
        <details class="amb">
          <summary><span class="serif">{g.n}. {g.name}</span> <span class="small muted">{g.units.length} propuestas</span></summary>
          <ul class="units">
            {g.units.map((u) => (
              <li class="card">
                <p class="small"><strong>{u.id}</strong> · p. {u.page}</p>
                <h3 class="serif">{u.title}</h3>
                <p>{u.text}</p>
                {u.condition && <p class="small muted">Condición: {u.condition}</p>}
                <p class="badges small">
                  <span>A {u.A ?? "–"}</span><span>B {u.B ?? "–"}</span><span>C {u.C ?? "–"}</span><span>E {u.E ?? "–"}</span>
                </p>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <section class="section section--pink">
    <div class="wrap grid2">
      <div>
        <p class="kicker">Equipo según el informe</p>
        <ul class="team">{party.team.map((t) => <li><strong>{t.name}</strong>. {t.role}.</li>)}</ul>
      </div>
      <div>
        <p class="kicker">Respaldo interno</p>
        <ul class="team">{party.internalSupport.map((s) => <li><strong>{s.area}.</strong> {s.evidence} <span class="small">Límite: {s.limit}</span></li>)}</ul>
        <p class="small">El informe solo recoge el disenso interno que está documentado. Si no aparece, el informe no lo documenta.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .party-hero__title { font-size: clamp(40px, 8vw, 104px); margin: 12px 0 20px; }
  .lead { max-width: 780px; font-size: 18px; margin-bottom: 24px; }
  .concl { list-style: none; padding: 0; margin: 0; display: grid; gap: 24px; }
  @media (min-width: 860px) { .concl { grid-template-columns: repeat(3, 1fr); } }
  .concl li { border-top: 5px solid #1f1f1f; padding-top: 12px; }
  .concl h2 { font-size: 21px; color: #1f1f1f; }
  .concl p { margin: 0; font-size: 15px; }
  .grid2 { display: grid; gap: 40px; }
  @media (min-width: 860px) { .grid2 { grid-template-columns: 1fr 1fr; } }
  .scen-list { display: grid; gap: 16px; margin: 0; }
  .scen-list dt { font-size: 16px; color: var(--ink-strong); }
  .scen-list dd { margin: 4px 0 0; }
  .plain-list { padding-left: 20px; }
  .close { list-style: none; padding: 0; display: grid; gap: 8px; }
  .close li { display: grid; grid-template-columns: 130px 1fr 36px; gap: 10px; align-items: center; }
  .close a { display: inline-block; padding: 10px 0; }
  .close__bar { height: 12px; background: color-mix(in srgb, var(--ink) 14%, transparent); position: relative; }
  .close__bar span { position: absolute; inset: 0 auto 0 0; background: var(--party); }
  .h2s { font-size: clamp(26px, 4vw, 44px); margin-bottom: 20px; }
  .pos-list { list-style: none; padding: 0; margin: 0; }
  .pos-list li { display: grid; gap: 4px 24px; padding: 10px 0; border-bottom: 1px solid var(--ink-strong); }
  @media (min-width: 860px) { .pos-list li { grid-template-columns: 2fr 1fr; } }
  .amb { border-top: 2px solid var(--line); padding: 8px 0; }
  .amb summary { font-size: 20px; gap: 12px; }
  .units { list-style: none; padding: 0; display: grid; gap: 12px; margin: 12px 0 20px; }
  @media (min-width: 860px) { .units { grid-template-columns: repeat(2, 1fr); } }
  .units h3 { font-size: 19px; margin: 4px 0 8px; }
  .badges { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0 0; }
  .badges span { border: 2px solid var(--line); padding: 2px 8px; font-weight: 700; }
  .team { padding-left: 18px; display: grid; gap: 10px; }
</style>
