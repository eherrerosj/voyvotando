---
import Base from "../../layouts/Base.astro";
import { PARTIES, QUESTIONS } from "../../lib/data";
import { DISPLAY } from "../../lib/format";
---
<Base title="Los 6 partidos · Voy Votando" description="Fichas de los 6 partidos incluidos en el test: programa, escenarios de gobierno, posiciones y propuestas.">
  <section class="section">
    <div class="wrap">
      <p class="kicker">Partidos incluidos</p>
      <h1 class="display title">Los 6 partidos</h1>
      <p class="lead">Por orden alfabético. Cada ficha resume el informe de evaluación de su programa: conclusiones, escenarios de gobierno, posiciones en el test y todas las propuestas analizadas.</p>
      <ul class="plist">
        {PARTIES.map((p) => (
          <li class="card">
            <h2 class="display">{DISPLAY[p.id]}</h2>
            <p class="small muted">{p.name}</p>
            <p>{p.report.units} propuestas analizadas. Posición documentada en {QUESTIONS.filter((q) => q.positions[p.id].value != null).length} de {QUESTIONS.length} preguntas.</p>
            <a class="btn btn--small" href={`/partidos/${p.id}`}>Ver ficha <span class="arrow" aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
      <p class="small">No incluidos por no tener informe: PNV, Junts, ERC, EH Bildu, BNG, Coalición Canaria y UPN.</p>
    </div>
  </section>
</Base>
<style>
  .title { font-size: clamp(40px, 8vw, 96px); margin: 12px 0 16px; }
  .lead { max-width: 760px; font-size: 18px; margin-bottom: 32px; }
  .plist { list-style: none; padding: 0; display: grid; gap: 20px; margin: 0 0 24px; }
  @media (min-width: 760px) { .plist { grid-template-columns: repeat(3, 1fr); } }
  .plist h2 { font-size: 30px; margin: 0; }
</style>
