---
import Base from "../layouts/Base.astro";
---
<Base title="Página no encontrada · Voy Votando">
  <section class="section">
    <div class="wrap">
      <p class="kicker">Error 404</p>
      <h1 class="display" style="font-size: clamp(40px, 8vw, 96px); margin: 12px 0 24px;">Esta página no existe</h1>
      <p style="font-size: 18px; max-width: 640px;">Puede que el enlace esté mal copiado. Si era un enlace de resultado, comprueba que incluye todo lo que va detrás del símbolo #.</p>
      <a class="btn btn--solid" href="/">Ir al inicio <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
